# --- Discord bot ---
DISCORD_TOKEN=your-bot-token
# Optional: your test server's ID. Makes slash commands appear instantly (global sync can take up to an hour).
DISCORD_GUILD_ID=

# --- Shared between bot and API ---
API_URL=http://127.0.0.1:8000
# Any long random string. The bot sends it and the API checks it.
API_KEY=change-me

# --- API ---
TMDB_API_KEY=your-tmdb-v3-api-key
TMDB_WATCH_REGION=US
REELCLUB_DB=reelclub.db
